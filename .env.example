# Copy to .env and fill in. Never commit .env.

# PostgreSQL connection string from Railway
DATABASE_URL=

# Auth: a long random string, and the site's address
AUTH_SECRET=
APP_URL=http://localhost:3000

# Google sign-in (leave empty to hide the Google button)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# First admin account, created by `npm run db:seed`
SEED_ADMIN_NAME=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# File storage for images and student documents (task 3.4)
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_PUBLIC_URL=

# Transactional email (task 4.7)
EMAIL_API_KEY=
EMAIL_FROM=
