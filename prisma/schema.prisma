generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────────── Accounts ─────────────────────────────

enum Role {
  ADMIN
  STAFF
  AGENT
  STUDENT
}

enum UserStatus {
  ACTIVE
  PENDING
  SUSPENDED
}

enum PermissionModule {
  LEADS
  STUDENTS
  APPLICATIONS
  AGENTS
  COMMISSIONS
  CONTENT
  USERS
  SETTINGS
  MARKETING
}

enum ApprovalStatus {
  PENDING
  CHANGES_REQUESTED
  APPROVED
  REJECTED
}

enum AgentKind {
  INDIVIDUAL
  AGENCY
}

// What an agency owner lets each team member do. The owner can always do everything.
enum AgentPermission {
  ALL_STUDENTS
  LEADS
  APPLICATIONS
  DOCUMENTS
  COMMISSION
  TEAM
}

enum AgentDocumentType {
  ID_PROOF
  ADDRESS_PROOF
  BUSINESS_REGISTRATION
  TAX_CERTIFICATE
  OFFICE_PHOTO
  REFERENCE_LETTER
  OTHER
}

model User {
  id               String     @id @default(cuid())
  name             String
  email            String     @unique
  emailVerified    Boolean    @default(false)
  phone            String?
  image            String?
  // Set by Better Auth's two-factor plugin once an authenticator app is confirmed.
  twoFactorEnabled Boolean    @default(false)
  role             Role       @default(STUDENT)
  status           UserStatus @default(ACTIVE)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  sessions         Session[]
  accounts         Account[]
  staffPermissions StaffPermission[]
  agentProfile     AgentProfile?
  studentProfile   StudentProfile?
  // Set for an agent's team member: they sign in as AGENT and work under that agency.
  agentTeamId      String?
  // For team members: what the agency owner lets them do (see AgentPermission).
  agentPermissions AgentPermission[]
  agentTeam        AgentProfile?     @relation("AgentTeam", fields: [agentTeamId], references: [id], onDelete: Cascade)
  addedStudents    StudentProfile[]  @relation("StudentAddedBy")

  approvedAgents       AgentProfile[]         @relation("AgentApprovedBy")
  counselledStudents   StudentProfile[]       @relation("StudentCounsellor")
  assignedLeads        Lead[]                 @relation("LeadAssignedStaff")
  assignedApplications Application[]          @relation("ApplicationAssignedStaff")
  submittedApps        Application[]          @relation("ApplicationSubmittedBy")
  applicationEvents    ApplicationEvent[]
  documentRequests     DocumentRequest[]      @relation("DocumentRequestCreatedBy")
  conditionsAdded      ApplicationCondition[] @relation("ConditionCreatedBy")
  conditionsMet        ApplicationCondition[] @relation("ConditionMetBy")
  uploadedDocuments    Document[]             @relation("DocumentUploadedBy")
  reviewedDocuments    Document[]             @relation("DocumentReviewedBy")
  reviewedAgentDocs    AgentDocument[]        @relation("AgentDocumentReviewedBy")
  agentDocRequests     AgentDocumentRequest[] @relation("AgentDocumentRequestCreatedBy")
  agentLeads           Lead[]                 @relation("LeadAgentMember")
  notes                Note[]
  messages             Message[]
  reminders            Reminder[]
  countryAssignments   CountryAssignment[]
  blogPosts            BlogPost[]
  activityLogs         ActivityLog[]
  uploads              Upload[]
  notifications        Notification[]
  twoFactor            TwoFactor?

  @@index([role, status])
  @@index([agentTeamId])
}

// Session, Account and Verification follow the shape Better Auth expects.
// Passwords are stored hashed on Account (providerId "credential"), not on User.
model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Authenticator-app secret and one-time backup codes (Better Auth two-factor plugin; stored encrypted).
model TwoFactor {
  id                      String    @id @default(cuid())
  userId                  String    @unique
  secret                  String
  backupCodes             String
  verified                Boolean   @default(true)
  failedVerificationCount Int       @default(0)
  lockedUntil             DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([secret])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

// Request counts for sign-in (Better Auth, storage: "database") and the public forms (lib/rate-limit.ts).
// Kept in the database because each Vercel instance has its own memory.
model RateLimit {
  id          String @id @default(cuid())
  key         String @unique
  count       Int
  lastRequest BigInt
}

// Staff see everything by default; a row here overrides access for one module.
model StaffPermission {
  id      String           @id @default(cuid())
  userId  String
  module  PermissionModule
  canView Boolean          @default(true)
  canEdit Boolean          @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, module])
}

// NRC's own sub-agents, who refer students from the country they operate in.
// An agent registers as a single person (INDIVIDUAL) or on behalf of an agency (AGENCY,
// which can add team members). They sign in straight away to an onboarding page, upload
// verification documents, and get the full portal once an admin approves them.
model AgentProfile {
  id                        String          @id @default(cuid())
  userId                    String          @unique
  kind                      AgentKind       @default(INDIVIDUAL)
  companyName               String?
  registrationNumber        String?
  website                   String?
  yearsActive               Int?
  studentsPerYear           Int?
  countryId                 String?
  phone                     String?
  address                   String?
  about                     String?
  approvalStatus            ApprovalStatus  @default(PENDING)
  // What the admin asked to change, or why they rejected; shown to the agent.
  reviewNote                String?
  // When the agent last sent the profile for review.
  submittedAt               DateTime?
  approvedById              String?
  approvedAt                DateTime?
  // An approved individual asking to become an agency. Null when there is no request;
  // PENDING / CHANGES_REQUESTED while open; REJECTED keeps the last refusal visible.
  upgradeStatus             ApprovalStatus?
  upgradeCompanyName        String?
  upgradeRegistrationNumber String?
  upgradeNote               String?
  upgradeRequestedAt        DateTime?
  createdAt                 DateTime        @default(now())
  updatedAt                 DateTime        @updatedAt

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  country    Country? @relation(fields: [countryId], references: [id], onDelete: SetNull)
  approvedBy User?    @relation("AgentApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)

  students           StudentProfile[]
  team               User[]                 @relation("AgentTeam")
  applications       Application[]
  leads              Lead[]
  commissions        Commission[]
  countryAssignments CountryAssignment[]
  verification       AgentDocument[]
  documentRequests   AgentDocumentRequest[]
  notes              Note[]

  @@index([countryId])
  @@index([approvalStatus])
  @@index([upgradeStatus])
}

// A verification file an agent uploads during onboarding, checked by NRC staff.
model AgentDocument {
  id           String            @id @default(cuid())
  agentId      String
  type         AgentDocumentType
  name         String
  fileKey      String
  contentType  String
  status       DocumentStatus    @default(PENDING)
  reviewNote   String?
  reviewedById String?
  reviewedAt   DateTime?
  createdAt    DateTime          @default(now())

  // Set when uploaded in answer to something NRC asked for.
  requestId String?

  agent      AgentProfile          @relation(fields: [agentId], references: [id], onDelete: Cascade)
  reviewedBy User?                 @relation("AgentDocumentReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  request    AgentDocumentRequest? @relation(fields: [requestId], references: [id], onDelete: SetNull)

  @@index([agentId])
  @@index([requestId])
}

// A specific file NRC asks an agent for (e.g. two references). Open until a file for it is
// approved, or staff cancel it. Open requests hold back approval.
model AgentDocumentRequest {
  id           String            @id @default(cuid())
  agentId      String
  type         AgentDocumentType
  label        String
  instructions String?
  isOpen       Boolean           @default(true)
  createdById  String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  agent     AgentProfile    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  createdBy User?           @relation("AgentDocumentRequestCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  documents AgentDocument[]

  @@index([agentId, isOpen])
}

// ───────────────────────────── Students ─────────────────────────────

enum StudyLevel {
  // Only used for a student's past education (A-Level, HSC, high school); courses never use it.
  SCHOOL
  FOUNDATION
  DIPLOMA
  UNDERGRADUATE
  POSTGRADUATE
  PHD
  OTHER
}

enum DocumentType {
  PASSPORT
  PHOTO
  TRANSCRIPT
  CERTIFICATE
  ENGLISH_TEST
  SOP
  RECOMMENDATION_LETTER
  CV
  FINANCIAL
  OFFER_LETTER
  CAS
  VISA
  OTHER
}

enum DocumentStatus {
  PENDING
  APPROVED
  REJECTED
}

model StudentProfile {
  id                   String    @id @default(cuid())
  userId               String    @unique
  dateOfBirth          DateTime? @db.Date
  gender               String?
  nationality          String?
  // Studied in English, so a medium-of-instruction letter may replace an English test.
  englishMedium        Boolean   @default(false)
  passportNumber       String?
  passportExpiry       DateTime? @db.Date
  phone                String?
  address              String?
  countryId            String?
  counsellorId         String?
  agentId              String?
  // Which agent account (the agency owner or a team member) added this student.
  addedById            String?
  // Staff can stop a student starting more applications themselves; staff can still add them.
  canStartApplications Boolean   @default(true)
  // Staff tick each section once they have checked it; editing the section clears the tick.
  profileConfirmedAt   DateTime?
  profileConfirmedBy   String?
  educationConfirmedAt DateTime?
  educationConfirmedBy String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  addedBy    User?         @relation("StudentAddedBy", fields: [addedById], references: [id], onDelete: SetNull)
  country    Country?      @relation(fields: [countryId], references: [id], onDelete: SetNull)
  counsellor User?         @relation("StudentCounsellor", fields: [counsellorId], references: [id], onDelete: SetNull)
  agent      AgentProfile? @relation(fields: [agentId], references: [id], onDelete: SetNull)

  educationRecords EducationRecord[]
  testScores       TestScore[]
  documents        Document[]
  documentRequests DocumentRequest[]
  applications     Application[]
  notes            Note[]
  messages         Message[]
  reminders        Reminder[]
  lead             Lead?

  @@index([counsellorId])
  @@index([agentId])
  @@index([addedById])
  @@index([countryId])
}

model EducationRecord {
  id            String     @id @default(cuid())
  studentId     String
  level         StudyLevel
  institution   String
  fieldOfStudy  String?
  result        String?
  // Structured result for matching: grade out of gradeOutOf (e.g. 4.5 of 5, 72 of 100).
  grade         Decimal?   @db.Decimal(6, 2)
  gradeOutOf    Decimal?   @db.Decimal(6, 2)
  yearCompleted Int?

  student StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
}

model TestScore {
  id        String    @id @default(cuid())
  studentId String
  test      String
  score     String
  // Structured score for matching; lowest is the lowest section or band.
  overall   Decimal?  @db.Decimal(5, 1)
  lowest    Decimal?  @db.Decimal(5, 1)
  takenAt   DateTime? @db.Date

  student StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
}

model Document {
  id            String         @id @default(cuid())
  studentId     String
  applicationId String?
  // The request (upload slot) this file answers, when there is one.
  requestId     String?
  type          DocumentType
  name          String
  fileUrl       String
  fileKey       String?
  status        DocumentStatus @default(PENDING)
  reviewNote    String?
  uploadedById  String?
  reviewedById  String?
  reviewedAt    DateTime?
  createdAt     DateTime       @default(now())

  student     StudentProfile   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  application Application?     @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  request     DocumentRequest? @relation(fields: [requestId], references: [id], onDelete: SetNull)
  uploadedBy  User?            @relation("DocumentUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)
  reviewedBy  User?            @relation("DocumentReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([studentId])
  @@index([applicationId])
  @@index([requestId])
}

enum DocumentRequestStatus {
  REQUESTED
  UPLOADED
  APPROVED
  NEEDS_REUPLOAD
  WAIVED
}

// One document staff need from a student: an upload slot on the student's portal.
// Students can upload only into a slot that is open; approving a file closes it.
// applicationId empty means a general document, not tied to one application.
model DocumentRequest {
  id            String                @id @default(cuid())
  studentId     String
  applicationId String?
  type          DocumentType
  label         String
  instructions  String?
  required      Boolean               @default(true)
  status        DocumentRequestStatus @default(REQUESTED)
  isOpen        Boolean               @default(true)
  dueAt         DateTime?             @db.Date
  createdById   String?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  student     StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  application Application?   @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  createdBy   User?          @relation("DocumentRequestCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  documents   Document[]

  @@index([studentId])
  @@index([applicationId])
}

// ─────────────────────────────── CRM ────────────────────────────────

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  CONVERTED
  LOST
}

enum LeadSource {
  CONSULTATION_FORM
  CONTACT_FORM
  START_YOUR_JOURNEY
  AGENT
  MANUAL
}

// The order and the rules for moving between stages live in src/lib/application-flow.ts.
enum ApplicationStage {
  NEW
  DOCUMENTS_PENDING
  READY_TO_SUBMIT
  SUBMITTED_TO_UNIVERSITY
  UNIVERSITY_QUERY
  CONDITIONAL_OFFER
  UNCONDITIONAL_OFFER
  OFFER_ACCEPTED
  DEPOSIT_PAID
  CAS_REQUESTED
  CAS_ISSUED
  VISA_APPLIED
  VISA_GRANTED
  ENROLLED
  REJECTED
  OFFER_DECLINED
  VISA_REFUSED
  WITHDRAWN
}

enum CommissionDirection {
  UNIVERSITY_TO_NRC
  NRC_TO_AGENT
}

enum CommissionStatus {
  PENDING
  SETTLED
  CANCELLED
}

model Lead {
  id                   String      @id @default(cuid())
  name                 String
  email                String
  phone                String?
  countryId            String?
  destinationCountryId String?
  studyLevel           StudyLevel?
  message              String?
  source               LeadSource  @default(CONSULTATION_FORM)
  status               LeadStatus  @default(NEW)
  assignedStaffId      String?
  assignedAgentId      String?
  // Inside the agency: which agent account handles it, and when to follow up.
  agentUserId          String?
  followUpAt           DateTime?
  studentId            String?     @unique
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  // country: where the lead lives (used for routing); destination: where they want to study.
  country       Country?        @relation("LeadCountry", fields: [countryId], references: [id], onDelete: SetNull)
  destination   Country?        @relation("LeadDestination", fields: [destinationCountryId], references: [id], onDelete: SetNull)
  assignedStaff User?           @relation("LeadAssignedStaff", fields: [assignedStaffId], references: [id], onDelete: SetNull)
  assignedAgent AgentProfile?   @relation(fields: [assignedAgentId], references: [id], onDelete: SetNull)
  agentUser     User?           @relation("LeadAgentMember", fields: [agentUserId], references: [id], onDelete: SetNull)
  student       StudentProfile? @relation(fields: [studentId], references: [id], onDelete: SetNull)

  notes     Note[]
  reminders Reminder[]

  @@index([status])
  @@index([assignedStaffId])
  @@index([assignedAgentId])
  @@index([countryId])
}

// Default owner for new leads from a country; admin can still reassign each lead.
model CountryAssignment {
  id        String  @id @default(cuid())
  countryId String  @unique
  staffId   String?
  agentId   String?

  country Country       @relation(fields: [countryId], references: [id], onDelete: Cascade)
  staff   User?         @relation(fields: [staffId], references: [id], onDelete: SetNull)
  agent   AgentProfile? @relation(fields: [agentId], references: [id], onDelete: SetNull)
}

model Application {
  id              String           @id @default(cuid())
  studentId       String
  courseId        String
  intakeId        String?
  stage           ApplicationStage @default(NEW)
  assignedStaffId String?
  agentId         String?
  submittedById   String?
  // Filled in as the application moves along.
  universityRef   String?
  casNumber       String?
  visaReference   String?
  depositAmount   Decimal?         @db.Decimal(12, 2)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  student       StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  course        Course         @relation(fields: [courseId], references: [id], onDelete: Restrict)
  intake        Intake?        @relation(fields: [intakeId], references: [id], onDelete: SetNull)
  assignedStaff User?          @relation("ApplicationAssignedStaff", fields: [assignedStaffId], references: [id], onDelete: SetNull)
  agent         AgentProfile?  @relation(fields: [agentId], references: [id], onDelete: SetNull)
  submittedBy   User?          @relation("ApplicationSubmittedBy", fields: [submittedById], references: [id], onDelete: SetNull)

  events           ApplicationEvent[]
  documentRequests DocumentRequest[]
  conditions       ApplicationCondition[]
  documents        Document[]
  notes            Note[]
  reminders        Reminder[]
  commissions      Commission[]

  @@index([studentId])
  @@index([courseId])
  @@index([stage])
  @@index([assignedStaffId])
  @@index([agentId])
}

// Everything that happens to an application: stage moves, document requests, uploads and
// reviews, conditions, detail changes, WhatsApp chats. Never edited or deleted.
// Types and their wording are in src/lib/application-flow.ts.
model ApplicationEvent {
  id               String            @id @default(cuid())
  applicationId    String
  actorId          String?
  type             String
  fromStage        ApplicationStage?
  toStage          ApplicationStage?
  note             String?
  visibleToStudent Boolean           @default(false)
  meta             Json?
  createdAt        DateTime          @default(now())

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  actor       User?       @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([applicationId, createdAt])
}

// A condition on a conditional offer, e.g. "IELTS 6.5 overall". All must be met before
// the application can move to Unconditional offer.
model ApplicationCondition {
  id            String    @id @default(cuid())
  applicationId String
  text          String
  metAt         DateTime?
  metById       String?
  createdById   String?
  createdAt     DateTime  @default(now())

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  metBy       User?       @relation("ConditionMetBy", fields: [metById], references: [id], onDelete: SetNull)
  createdBy   User?       @relation("ConditionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([applicationId])
}

// Internal staff note attached to a lead, a student or an application.
model Note {
  id            String   @id @default(cuid())
  authorId      String?
  body          String
  // Set for notes written in an agency's CRM: that agency sees them; staff see all notes.
  agentId       String?
  leadId        String?
  studentId     String?
  applicationId String?
  createdAt     DateTime @default(now())

  author      User?           @relation(fields: [authorId], references: [id], onDelete: SetNull)
  agent       AgentProfile?   @relation(fields: [agentId], references: [id], onDelete: Cascade)
  lead        Lead?           @relation(fields: [leadId], references: [id], onDelete: Cascade)
  student     StudentProfile? @relation(fields: [studentId], references: [id], onDelete: Cascade)
  application Application?    @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([studentId])
  @@index([applicationId])
}

// One conversation thread per student, between the student and NRC staff.
model Message {
  id        String    @id @default(cuid())
  studentId String
  senderId  String?
  body      String
  readAt    DateTime?
  createdAt DateTime  @default(now())

  student StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  sender  User?          @relation(fields: [senderId], references: [id], onDelete: SetNull)

  @@index([studentId, createdAt])
}

model Reminder {
  id            String    @id @default(cuid())
  staffId       String
  text          String
  dueAt         DateTime
  doneAt        DateTime?
  leadId        String?
  studentId     String?
  applicationId String?
  createdAt     DateTime  @default(now())

  staff       User            @relation(fields: [staffId], references: [id], onDelete: Cascade)
  lead        Lead?           @relation(fields: [leadId], references: [id], onDelete: Cascade)
  student     StudentProfile? @relation(fields: [studentId], references: [id], onDelete: Cascade)
  application Application?    @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([staffId, dueAt])
}

// UNIVERSITY_TO_NRC: income NRC earns from the university.
// NRC_TO_AGENT: payout NRC owes the referring sub-agent (agentId set).
model Commission {
  id            String              @id @default(cuid())
  applicationId String
  direction     CommissionDirection
  agentId       String?
  ratePercent   Decimal?            @db.Decimal(5, 2)
  amount        Decimal             @db.Decimal(12, 2)
  currency      String              @default("GBP")
  status        CommissionStatus    @default(PENDING)
  settledAt     DateTime?
  note          String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  application Application   @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  agent       AgentProfile? @relation(fields: [agentId], references: [id], onDelete: SetNull)

  @@index([applicationId])
  @@index([agentId])
  @@index([direction, status])
}

model ActivityLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  entityType String
  entityId   String?
  meta       Json?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([createdAt])
}

// ───────────────────────── Website content ──────────────────────────

enum PostStatus {
  DRAFT
  PUBLISHED
}

// Both study destinations (isDestination) and the countries students and agents come from.
model Country {
  id            String   @id @default(cuid())
  name          String   @unique
  slug          String   @unique
  isoCode       String?  @unique
  flagUrl       String?
  imageUrl      String?
  description   String?
  // One or two lines on the destination banner.
  tagline       String?
  // Markdown details shown below the banner.
  content       String?
  isDestination Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  universities     University[]
  agents           AgentProfile[]
  students         StudentProfile[]
  leads            Lead[]             @relation("LeadCountry")
  destinationLeads Lead[]             @relation("LeadDestination")
  assignment       CountryAssignment?
}

// How a university receives applications.
enum ApplicationMethod {
  DIRECT_PORTAL
  AGENT_PORTAL
  EMAIL
  UCAS
  OTHER
}

model University {
  id                  String             @id @default(cuid())
  name                String
  slug                String             @unique
  countryId           String
  city                String?
  logoUrl             String?
  coverUrl            String?
  description         String?
  website             String?
  ranking             Int?
  isOfficialPartner   Boolean            @default(false)
  isFeatured          Boolean            @default(false)
  isPublished         Boolean            @default(false)
  // Internal only; never send these to public pages.
  nrcCommissionRate   Decimal?           @db.Decimal(5, 2)
  agentCommissionRate Decimal?           @db.Decimal(5, 2)
  // How this university's process differs: the name of its confirmation of enrolment
  // (CAS in the UK, I-20 in the US, CoE in Australia, LOA in Canada), steps that do not
  // apply, and internal notes on how to apply.
  confirmationName    String             @default("CAS")
  skippedStages       ApplicationStage[]
  processNotes        String?
  applicationMethod   ApplicationMethod?
  applicationUrl      String?
  applicationEmail    String?
  // Entry requirement defaults for every course here; a course's own value wins.
  minGradePercent     Decimal?           @db.Decimal(5, 2)
  minIelts            Decimal?           @db.Decimal(3, 1)
  minIeltsBand        Decimal?           @db.Decimal(3, 1)
  maxStudyGapYears    Int?
  acceptsMoi          Boolean?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  country      Country                 @relation(fields: [countryId], references: [id], onDelete: Restrict)
  courses      Course[]
  intakes      Intake[]
  requirements UniversityRequirement[]

  @@index([countryId])
  @@index([isPublished])
}

model Subject {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?
  imageUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  courses Course[]
}

model Course {
  id                String      @id @default(cuid())
  universityId      String
  subjectId         String?
  name              String
  slug              String
  level             StudyLevel
  durationMonths    Int?
  tuitionFee        Decimal?    @db.Decimal(12, 2)
  currency          String      @default("GBP")
  description       String?
  entryRequirements String?
  // Structured entry requirements used by the course finder. Empty means "use the
  // university default", then the level default in lib/course-match.ts.
  requiredLevel     StudyLevel?
  minGradePercent   Decimal?    @db.Decimal(5, 2)
  minIelts          Decimal?    @db.Decimal(3, 1)
  minIeltsBand      Decimal?    @db.Decimal(3, 1)
  maxStudyGapYears  Int?
  acceptsMoi        Boolean?
  isPublished       Boolean     @default(false)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  university   University    @relation(fields: [universityId], references: [id], onDelete: Cascade)
  subject      Subject?      @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  intakes      Intake[]
  applications Application[]

  @@unique([universityId, slug])
  @@index([subjectId])
  @@index([level])
}

// A document this university always asks for. Copied onto each new application as a
// document request, so the student sees the right checklist for that university.
model UniversityRequirement {
  id           String       @id @default(cuid())
  universityId String
  type         DocumentType
  label        String
  instructions String?
  required     Boolean      @default(true)
  sortOrder    Int          @default(0)

  university University @relation(fields: [universityId], references: [id], onDelete: Cascade)

  @@index([universityId])
}

// courseId empty means the intake applies to every course at the university.
model Intake {
  id                  String    @id @default(cuid())
  universityId        String
  courseId            String?
  name                String
  startDate           DateTime  @db.Date
  applicationDeadline DateTime? @db.Date
  isOpen              Boolean   @default(true)

  university   University    @relation(fields: [universityId], references: [id], onDelete: Cascade)
  course       Course?       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  applications Application[]

  @@index([universityId])
  @@index([courseId])
  @@index([startDate])
}

// NRC's own offices, shown on the contact and home pages.
model Office {
  id           String   @id @default(cuid())
  name         String
  city         String
  country      String
  address      String
  phone        String?
  email        String?
  openingHours String?
  mapUrl       String?
  imageUrl     String?
  isHeadOffice Boolean  @default(false)
  sortOrder    Int      @default(0)
  isPublished  Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([isPublished, sortOrder])
}

// Slides in the home page hero slider, managed from the admin panel.
model HeroSlide {
  id          String   @id @default(cuid())
  eyebrow     String?
  title       String
  subtitle    String?
  imageUrl    String?
  buttonLabel String?
  buttonHref  String?
  sortOrder   Int      @default(0)
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isPublished, sortOrder])
}

model TestPrepPage {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  summary     String?
  content     String?
  // Key facts shown as a list, e.g. [{"label":"Duration","value":"2 h 45 min"}].
  facts       Json?
  // Mark distribution tables: [{"title","columns":[...],"rows":[[...]],"note"}]. Edited in the dashboard.
  tables      Json?
  imageUrl    String?
  sortOrder   Int      @default(0)
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model BlogPost {
  id          String     @id @default(cuid())
  title       String
  slug        String     @unique
  excerpt     String?
  content     String
  coverUrl    String?
  status      PostStatus @default(DRAFT)
  publishedAt DateTime?
  authorId    String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  author User? @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([status, publishedAt])
}

model Testimonial {
  id          String   @id @default(cuid())
  name        String
  photoUrl    String?
  headline    String?
  quote       String
  rating      Int?
  sortOrder   Int      @default(0)
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
}

// Logos for the "partnered with" strip that are not universities in the catalogue.
model Partner {
  id          String  @id @default(cuid())
  name        String
  logoUrl     String?
  website     String?
  sortOrder   Int     @default(0)
  isPublished Boolean @default(true)
}

model Faq {
  id          String  @id @default(cuid())
  question    String
  answer      String
  category    String?
  sortOrder   Int     @default(0)
  isPublished Boolean @default(true)
}

// Key/value store: contact details, social links, menus, home page figures.
model SiteSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

// ───────────────────────────── Files ─────────────────────────────

// Every file stored in object storage. Used for auditing, per-user rate limits and,
// later, cleaning up files nothing points to any more.
model Upload {
  id           String   @id @default(cuid())
  key          String   @unique
  url          String
  contentType  String
  size         Int
  width        Int?
  height       Int?
  originalName String?
  uploadedById String?
  createdAt    DateTime @default(now())

  uploadedBy User? @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([uploadedById, createdAt])
}

// ───────────────────────────── Notifications ─────────────────────────────

// In-app notices for one user, created when something happens that they can act on.
// Who receives each one is decided in src/lib/notifications.ts from their role and access.
model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      String
  title     String
  body      String?
  href      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([userId, createdAt])
}

// ── Marketing ─────────────────────────────────────────────────────────────────

enum SocialPlatform {
  FACEBOOK
  INSTAGRAM
  TIKTOK
  YOUTUBE
  LINKEDIN
  X
  WHATSAPP
  GOOGLE_BUSINESS
  OTHER
}

enum CampaignChannel {
  SOCIAL
  EMAIL
  SMS
  ADS
  EVENT
  OTHER
}

enum CampaignStatus {
  PLANNING
  DESIGN
  READY
  LIVE
  DONE
  CANCELLED
}

enum ContentPostStatus {
  IDEA
  DESIGNING
  READY
  POSTED
}

// NRC's social media pages and who can get into them. The password is encrypted
// (lib/secret-box.ts) and only admins can see or change it.
model SocialAccount {
  id                String         @id @default(cuid())
  platform          SocialPlatform
  name              String
  url               String?
  handle            String?
  loginEmail        String?
  passwordEncrypted String?
  twoFactorNote     String?
  managedBy         String?
  followers         Int?
  notes             String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@index([platform])
}

// A marketing push over a period: a social series, an email or SMS blast, ads or an event.
model Campaign {
  id        String          @id @default(cuid())
  name      String
  channel   CampaignChannel
  status    CampaignStatus  @default(PLANNING)
  startDate DateTime?
  endDate   DateTime?
  budget    Decimal?        @db.Decimal(12, 2)
  currency  String          @default("GBP")
  goal      String?
  audience  String?
  message   String?
  designUrl String?
  owner     String?
  results   String?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  posts ContentPost[]

  @@index([status, startDate])
}

// One planned post in the content calendar, from idea through design to posted.
model ContentPost {
  id         String            @id @default(cuid())
  title      String
  platform   SocialPlatform
  publishOn  DateTime
  status     ContentPostStatus @default(IDEA)
  caption    String?
  designUrl  String?
  postUrl    String?
  assignee   String?
  campaignId String?
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  campaign Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  @@index([publishOn])
}

// One public page view, recorded by /api/track. No cookies: visitorHash is a hash of the
// address, browser and day, so a visitor counts once a day and cannot be followed across days.
model PageView {
  id          String   @id @default(cuid())
  path        String
  source      String
  referrer    String?
  utmMedium   String?
  utmCampaign String?
  country     String?
  region      String?
  city        String?
  device      String
  browser     String
  visitorHash String
  createdAt   DateTime @default(now())

  @@index([createdAt])
}
